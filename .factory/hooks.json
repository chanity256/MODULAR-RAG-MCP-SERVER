{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$FACTORY_PROJECT_DIR\"/.factory/hooks/test_guard.py reset",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$FACTORY_PROJECT_DIR\"/.factory/hooks/docs_guard.py snapshot",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(Edit|Create|ApplyPatch|Execute)$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$FACTORY_PROJECT_DIR\"/.factory/hooks/test_guard.py pre",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$FACTORY_PROJECT_DIR\"/.factory/hooks/docs_guard.py stop",
          "timeout": 45
        }
      ]
    }
  ]
}
