# Sirchmunk sidecar 环境模板 — S0.1（SIRCHMUNK_INTEGRATION_SPEC 6.2）。
# 用法: cp scripts/sirchmunk/env.example .env-sirchmunk 并填入真实值；
# 该文件属 sidecar venv 侧配置，密钥不入主仓库。

# LLM（仅 OpenAI 兼容端点；sirchmunk 无原生 Azure 支持，spec 4.5）
# 推荐 DeepSeek deepseek-v4-flash：上游对 deepseek-v4-* 自动发送 thinking: disabled，
# 小 prompt 约 1s。不推荐 glm-5.3-flash：该模型强制思考（关闭时 API 返回 1210），
# 而上游 zhipu profile 无思考控制参数，sidecar 无法降低推理开销（S0 实测单次 LLM 调用 23–220s，spec 4.5.1）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=change-me
LLM_MODEL_NAME=deepseek-v4-flash

# 工作目录（Parquet 知识簇 / spec / grep 缓存；每进程独占，spec 4.7）
SIRCHMUNK_WORK_PATH=./data/db/sirchmunk

# 关闭知识簇复用：跳过 embedding 模型下载与常驻内存（spec 4.1）。
# 注意：上游对未设置的该变量按 true 处理（api/search.py），删掉或注释掉这一行 = 开启复用。
SIRCHMUNK_ENABLE_CLUSTER_REUSE=false

# SX4：知识簇复用（开启为显式动作：把上一行改为 true，再按需取消下面的注释）。
# 开启前先跑 preflight.sh 预下载 embedding 模型，避免首次搜索卡在模型加载；
# 评估前清空 ${SIRCHMUNK_WORK_PATH}/.cache/knowledge/（复用关闭时保存的簇没有 embedding）。
# CLUSTER_SIM_THRESHOLD=0.85      # 余弦相似度阈值，越高越不易误复用
# CLUSTER_SIM_TOP_K=3             # 候选簇数
# EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=${SIRCHMUNK_WORK_PATH}/.cache/models   # 缺省即此目录

# sidecar HTTP 鉴权（与主项目 agentic_search.api_token 使用同一随机 token）
SIRCHMUNK_API_TOKEN=generate-a-random-token

# 超预算硬失败：防客户端断连后成本泄漏（spec 4.7）
LENS_HARD_TOKEN_BUDGET=true

# sidecar 监听地址（主项目 base_url 需一致）
SIRCHMUNK_BASE_URL=http://127.0.0.1:8584

# SX3：compile.sh 未显式传 `-- <paths>` 时的编译路径（相对仓库根，空格分隔）。
# 不要放 "." 或 data/documents：前者会扫进 .venv/build（上游 rglob 不读 .gitignore），
# 后者是与 golden 集无关的用户文档，编译会把全文发给 LLM。
SIRCHMUNK_COMPILE_PATHS="README.md docs"
