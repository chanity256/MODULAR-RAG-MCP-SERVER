# PageIndex sidecar 环境模板 — PI0.1（PAGEINDEX_TREE_RETRIEVAL_SPEC 3.3）。
# 用法: cp scripts/pageindex/env.example .env-pageindex 并填入真实值；
# 该文件属 sidecar venv 侧配置，密钥不入主仓库。

# sidecar HTTP 鉴权（主项目 tree_search.api_token 使用同一随机 token）
PAGEINDEX_API_TOKEN=generate-a-random-token

# sidecar 监听地址（主项目 tree_search.base_url 需一致；只绑 loopback）
PAGEINDEX_HOST=127.0.0.1
PAGEINDEX_PORT=8585

# 树索引存储（上游 PDF DocStore + 映射；已被 denied_substrings 的 data/db 覆盖）。
# 派生 PDF 固定落 <PAGEINDEX_STORAGE>/derived/<md_sha256>.pdf，不单独配置（D12）。
PAGEINDEX_STORAGE=./data/db/pageindex

# 建树摘要并发（3.2：显式低并发，防上游默认 128 触发低 RPM 账户 429；PI0 实测 3 可用）
PAGEINDEX_SUMMARY_CONCURRENCY=3

# MD → 派生 PDF 转换链（D11：pandoc → HTML → headless Chromium print-to-pdf）。
# 两个可执行文件路径可选（留空则探测：pandoc 走 PATH；浏览器按
# PAGEINDEX_CHROMIUM > 系统 Chrome/Chromium > 可选 playwright 顺序）。
PAGEINDEX_PANDOC=
PAGEINDEX_CHROMIUM=
# 单篇转换超时（秒）
PAGEINDEX_RENDER_TIMEOUT_S=600

# LLM（D4：默认智谱 GLM，OpenAI 兼容端点；经 LiteLLM 命名 openai/<model> + api_base 透传）。
# PI0.3 实测该模型的工具调用 / JSON 输出质量后终裁回填规格 D4 行；换模型只改这里。
LLM_MODEL=openai/glm-5.3-flash
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=change-me
